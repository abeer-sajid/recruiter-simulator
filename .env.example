# Copy this file to `.env` and fill in the key.
#
# The boss fight (contact form) posts to Web3Forms. Get a free access key at
# https://web3forms.com — they email it to you, there is no dashboard to set up.
#
# With no key configured the form still works: it falls back to opening the
# visitor's mail client pre-filled and addressed to PROFILE.email. It never
# silently drops a message.
#
# On Vercel/Netlify, set this same variable in the project's Environment
# Variables instead of committing a .env file.

VITE_WEB3FORMS_KEY=
