{
  "name": "recruiter-simulator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An interactive portfolio for Abeer Sajid, shaped like a top-down pixel RPG.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-resume.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "check:content": "node scripts/check-content.mjs",
    "check:size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
